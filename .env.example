APP_NAME=Alquds
APP_ENV=local
APP_KEY=
# Keep false in any deployed environment so stack traces never leak.
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL only (16 locally; Neon in production). The invariants live in the database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alquds
DB_USERNAME=alquds
DB_PASSWORD=alquds
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Private uploads (S3-compatible, e.g. Cloudflare R2 in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Which disk holds private uploads (attachments, logos): `s3` in production, `local` here.
PRIVATE_DISK=local

# Sign in with Google — off until Al-Quds has a Workspace domain. Passwords always work
# while SSO_PASSWORDS_RETIRED=false.
SSO_GOOGLE_ENABLED=false
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
SSO_ALLOWED_DOMAINS=
SSO_PASSWORDS_RETIRED=false
SSO_BREAKGLASS_EMAILS=

# AI: the Claude API when its key is set, else OpenRouter. Drafts only; no feature ships yet.
AI_ENABLED=true
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# WhatsApp (Meta Cloud API). Credentials from the environment only.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_AUTH_TEMPLATE=sign_in_code
WHATSAPP_AUTH_TEMPLATE_LANG=en
WHATSAPP_DEFAULT_COUNTRY_CODE=20

# Imports at or above this many rows run on the queue worker (0 = never queue).
IO_QUEUE_THRESHOLD=200

# Nightly backup (02:15). MUST be off-box in production: an S3-compatible bucket and/or
# Google Drive. BACKUP_ALLOW_LOCAL=true only for a local dry run.
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=30
BACKUP_NOTIFY_EMAILS=
BACKUP_GOOGLE_DRIVE=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

VITE_APP_NAME="${APP_NAME}"
